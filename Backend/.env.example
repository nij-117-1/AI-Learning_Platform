# ──────────────────────────────────────
# LLM Provider — supports OpenAI / vLLM / Ollama / any OpenAI-compatible API
# ──────────────────────────────────────
LLM_MODEL_NAME=gpt-4o-mini          # e.g. gpt-4o, claude-3, deepseek-chat, local-model
LLM_API_KEY=sk-...                   # your API key (leave blank for local models)
LLM_API_BASE=https://api.openai.com/v1  # https://api.openai.com/v1 | http://localhost:11434/v1
LLM_TEMPERATURE=0.7                  # 0.0 (deterministic) – 2.0 (creative)
API_TRACE_ENABLED=false              # true logs each FastAPI request body, response body & duration
API_KEY=your-secret-api-key          # required X-API-Key header value to access the API (blank = auth disabled)
GRADER_STORAGE_DIR=Data/Grader       # directory where performance grader submissions are stored
TUTOR_PROMPTS_DIR=                   # directory for tutor prompt templates (blank = learning/tutor/prompts)
ROLEPLAY_STORAGE_DIR=Data/Linguistic/Roleplays  # directory where roleplay personas are stored (YAML)
SIMULATOR_PROMPTS_FILE=Data/Linguistic/Simulator/prompts.yaml  # YAML file storing simulator system prompts

# ──────────────────────────────────────
# Application
# ──────────────────────────────────────
APP_NAME=AI Learning Platform
DEBUG=false                           # set true for verbose logging & auto-reload
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR | CRITICAL
HOST=0.0.0.0
PORT=8000


